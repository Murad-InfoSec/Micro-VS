<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Micro VS, ported from .NET Framework 4.6.1 / WinForms (2019) to .NET 10 / Avalonia so it runs on
    macOS, Linux and Windows. The Model and Presenter are carried over from the original project
    (../Micro VS); the View is rewritten in Avalonia and CodeDOM is replaced by Roslyn.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Micro_VS</RootNamespace>
    <AssemblyName>MicroVS</AssemblyName>
    <Product>Micro VS</Product>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon />
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- System.IO.File would clash with Micro_VS.Model.ProjectInfo_micro_sln_.File. -->
    <Using Remove="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <!-- Roslyn CompletionService (IntelliSense-style code completion). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.9.0" />
  </ItemGroup>

</Project>
